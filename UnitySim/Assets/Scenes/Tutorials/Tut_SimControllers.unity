  m_Name: 
  m_EditorClassIdentifier: 
  title: Who is driving
  body: "Every car has one driver: you, the built-in bot, a firmware DLL, or an external
    app. They all write to the same actuator vector \u2014 motor volts, steering,
    brake \u2014 so nothing gets an advantage from being the one in charge."
  banner: 
  condition: 3
  trigger: {fileID: 0}
  input: 0
  amount: 0
  seconds: 8
  token: 
